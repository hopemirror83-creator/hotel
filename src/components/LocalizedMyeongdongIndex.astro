---
import HotelImage from './HotelImage.astro';
import AdSenseSlot from './AdSenseSlot.astro';
import InArticleAd from './InArticleAd.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { activeHotels } from '../data/hotels';
import { multilingualHotels } from '../data/multilingualHotels';
import { multilingualRegions, type MultilingualRegionKey } from '../data/multilingualRegions';
import type { Hotel } from '../data/hotels';

interface Props { lang: 'en' | 'ja'; isHome?: boolean; regionKey?: MultilingualRegionKey; }
const { lang, isHome = false, regionKey = 'myeongdong' } = Astro.props;
const isEnglish = lang === 'en';
const hotelBySlug = new Map(activeHotels.map((hotel) => [hotel.slug, hotel]));
const localizedData = multilingualHotels as Record<string, Record<'en' | 'ja', any>>;
type RegionConfig = (typeof multilingualRegions)[MultilingualRegionKey];
const selectedRegions: RegionConfig[] = isHome ? Object.values(multilingualRegions) : [multilingualRegions[regionKey]];
const getRegionHotels = (currentRegion: RegionConfig): Array<{ hotel: Hotel; content: any }> => currentRegion.slugs.flatMap((slug: string) => {
  const hotel = hotelBySlug.get(slug);
  const content = localizedData[slug]?.[lang];
  return hotel && content ? [{ hotel: hotel as Hotel, content }] : [];
});
const region = multilingualRegions[regionKey];
const canonicalPath = isHome ? `/${lang}/` : `/${lang}/${region.localePath}/`;
const title = isHome
  ? (isEnglish ? 'Korea Hotel Guides for International Travelers | HotelLog' : '海外旅行者向け韓国ホテルガイド | HotelLog')
  : (isEnglish ? `${region.enName} Hotel Reviews and Booking Guide | HotelLog` : `${region.jaName}ホテル比較・宿泊ガイド | HotelLog`);
const description = isHome
  ? (isEnglish ? 'Localized hotel guides for international visitors comparing Seoul stays by location, room conditions, breakfast and booking details.' : '海外旅行者向けに、立地・客室・朝食・予約条件からソウルのホテルを比較できる現地化ガイドです。')
  : (isEnglish ? `Compare selected hotels in ${region.enName} using public review patterns, location, room, breakfast and booking considerations.` : `${region.jaName}の人気ホテルを、公開口コミの傾向、立地、客室、朝食、予約前の注意点から比較できます。`);
const alternates = [
  { lang: 'en', path: isHome ? '/en/' : `/en/${region.localePath}/` },
  { lang: 'ja', path: isHome ? '/ja/' : `/ja/${region.localePath}/` },
  { lang: 'ko', path: isHome ? '/' : region.koPath },
  { lang: 'x-default', path: isHome ? '/' : region.koPath }
];
---

<BaseLayout title={title} description={description} canonicalPath={canonicalPath} lang={lang} alternates={alternates}>
  <section class="localized-index-hero">
    <div>
      <span>{isEnglish ? 'KOREA HOTEL GUIDE' : '韓国ホテルガイド'}</span>
      <h1>{isHome ? (isEnglish ? 'Selected Seoul hotels for international travelers' : '海外旅行者のためのソウルホテル選び') : (isEnglish ? region.enTitle : region.jaTitle)}</h1>
      <p>{isEnglish
        ? 'HotelLog reviews public search signals and hotel data to help international travelers compare location, room conditions, breakfast and booking details.'
        : 'HotelLogが公開検索情報とホテル基本データを整理し、立地・客室・朝食・予約条件を比較しやすくまとめました。'}</p>
    </div>
  </section>
  <AdSenseSlot placement="top" />
  {selectedRegions.map((currentRegion, regionIndex) => {
    const hotels = getRegionHotels(currentRegion);
    return <section class="localized-index-section">
      <div class="section-title"><span>{isEnglish ? currentRegion.enName.toUpperCase() : currentRegion.jaName}</span><h2>{isEnglish ? `${hotels.length} selected hotel guides` : `厳選ホテルガイド ${hotels.length}軒`}</h2></div>
      <p class="index-note">{isEnglish
        ? 'These are selectively localized guides, not a complete hotel inventory. Rates and room availability should be confirmed on the booking page.'
        : '全ホテルの一覧ではなく、公開口コミと画像情報が十分なホテルを選んだ現地化ガイドです。料金と空室は予約画面でご確認ください。'}</p>
      {isHome && <p><a class="region-guide-link" href={`/${lang}/${currentRegion.localePath}/`}>{isEnglish ? `Open the ${currentRegion.enName} guide` : `${currentRegion.jaName}ガイドを見る`}</a></p>}
      {regionIndex === 0 && <InArticleAd />}
      <div class="localized-hotel-grid">
        {hotels.map(({ hotel, content }) => (
        <a class="localized-hotel-card" href={`/${lang}/hotel/${hotel.slug}/`}>
          <div class="card-image"><HotelImage hotel={hotel} alt={content.hotelName} pendingLabel={isEnglish ? 'Image unavailable' : '画像準備中'} /></div>
          <div class="card-copy">
            <span>{content.regionLabel}</span><h2>{content.hotelName}</h2><p>{content.summary}</p>
            <div><strong>{hotel.reviewScore ?? '—'}</strong><small>{isEnglish ? `${(hotel.reviewCount || 0).toLocaleString('en-US')} reviews` : `口コミ ${(hotel.reviewCount || 0).toLocaleString('ja-JP')}件`}</small></div>
          </div>
        </a>
        ))}
      </div>
    </section>;
  })}
  <AdSenseSlot placement="bottom" />
</BaseLayout>

<style>
  .localized-index-hero,.localized-index-section{width:min(1120px,calc(100% - 32px));margin:0 auto;padding:54px 0 24px}
  .localized-index-hero>div{max-width:820px}.localized-index-hero span,.section-title span{color:var(--blue);font-weight:900;font-size:13px}
  .localized-index-hero h1{font-size:clamp(38px,6vw,72px);line-height:1.08;margin:14px 0 20px;letter-spacing:0;overflow-wrap:anywhere}
  .localized-index-hero p,.index-note{color:var(--muted);font-size:18px;line-height:1.7}
  .localized-hotel-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;margin-top:28px}
  .region-guide-link{display:inline-block;margin-top:12px;color:var(--blue);font-weight:800}
  .localized-hotel-card{display:grid;grid-template-columns:210px 1fr;background:var(--surface);border:1px solid var(--line);border-radius:8px;overflow:hidden;min-width:0}
  .card-image{min-height:220px}.card-image :global(img),.card-image :global(.image-pending){width:100%;height:100%;object-fit:cover}
  .card-copy{padding:20px;min-width:0}.card-copy>span{color:var(--blue);font-size:12px;font-weight:800}.card-copy h2{font-size:22px;line-height:1.3;margin:8px 0 12px;overflow-wrap:anywhere}.card-copy p{color:var(--muted);line-height:1.6;display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden}.card-copy div{display:flex;gap:10px;align-items:center;margin-top:16px}.card-copy strong{font-size:20px}.card-copy small{color:var(--muted)}
  @media(max-width:900px){.localized-hotel-grid{grid-template-columns:1fr}.localized-hotel-card{grid-template-columns:150px 1fr}}
  @media(max-width:560px){.localized-index-hero,.localized-index-section{width:calc(100% - 22px)}.localized-index-hero{padding-top:34px}.localized-index-hero h1{font-size:36px}.localized-hotel-card{grid-template-columns:1fr}.card-image{height:210px}.card-copy{padding:16px}}
</style>
