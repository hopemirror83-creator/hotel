---
interface Props { href: string; destination?: 'hokkaido' | 'tsushima'; context?: 'guide' | 'hotel'; placement?: 'top' | 'bottom' | 'middle'; }
const { href, destination = 'hokkaido', context = 'guide', placement = 'bottom' } = Astro.props;
const isHotel = context === 'hotel';
const isGuideTop = !isHotel && placement === 'top';
const copy = destination === 'tsushima'
  ? {
      hotelHeading: '대마도 여행이라면 패키지도 확인해보세요',
      topHeading: '부산에서 가까운 대마도 여행, 준비는 간단하게',
      bottomHeading: '자유여행과 패키지, 대마도에서는 어떤 일정이 편할까요?',
      hotelDescription: '배편과 숙박, 주요 관광 일정의 포함 조건을 대마도 여행 상품에서 함께 비교할 수 있습니다.',
      topDescription: '대마도 패키지의 이동편·숙박·관광 일정과 포함 조건을 함께 비교해보세요.',
      bottomDescription: '호텔을 직접 비교하고 있다면 이동편과 숙박, 관광 일정이 묶인 패키지 조건도 함께 살펴보세요.',
      hotelButton: '대마도 패키지 일정 보기',
      topButton: '대마도 패키지 일정 확인',
      bottomButton: '대마도 패키지 비교하기',
      aria: '대마도 패키지 상품 안내'
    }
  : {
      hotelHeading: '부모님과 함께라면 패키지도 확인해보세요',
      topHeading: '부모님과 함께하는 홋카이도 여행, 준비는 간단하게',
      bottomHeading: '자유여행과 패키지, 어떤 일정이 더 편할까요?',
      hotelDescription: '숙소와 이동, 주요 관광 일정이 포함된 홋카이도 여행 상품을 함께 비교할 수 있습니다.',
      topDescription: '항공·숙박·주요 관광 일정이 포함된 홋카이도 풀코스 패키지를 함께 비교해보세요.',
      bottomDescription: '호텔을 직접 비교하고 있다면 항공·숙박·관광 일정이 포함된 패키지 조건도 함께 살펴보세요.',
      hotelButton: '홋카이도 패키지 일정 보기',
      topButton: '홋카이도 패키지 일정 확인',
      bottomButton: '홋카이도 패키지 비교하기',
      aria: '홋카이도 패키지 상품 안내'
    };
const heading = isHotel ? copy.hotelHeading : isGuideTop ? copy.topHeading : copy.bottomHeading;
const description = isHotel ? copy.hotelDescription : isGuideTop ? copy.topDescription : copy.bottomDescription;
const buttonLabel = isHotel ? copy.hotelButton : isGuideTop ? copy.topButton : copy.bottomButton;
---

<aside class:list={['naver-package-cta', { 'naver-package-cta-hotel': isHotel }]} aria-label={copy.aria}>
  <span class="naver-package-label">NAVER TRAVEL CONNECT · 제휴 링크</span>
  <h2>{heading}</h2>
  <p>{description}</p>
  <a href={href} target="_blank" rel="nofollow sponsored noopener">{buttonLabel}</a>
  <small>상품 가격과 출발일, 포함 조건은 연결되는 판매 페이지에서 확인할 수 있습니다.</small>
</aside>

<style>
  .naver-package-cta { margin-top: 38px; padding: 24px; border: 1px solid #dbe5f2; border-radius: 8px; background: #f7faff; }
  .naver-package-cta-hotel { background: #fafbfc; }
  .naver-package-label { display: block; margin-bottom: 9px; color: #496783; font-size: 11px; font-weight: 700; }
  h2 { margin: 0; color: #172b4d; font-size: 21px; line-height: 1.38; }
  p { margin: 10px 0 18px; color: #526172; font-size: 15px; line-height: 1.7; word-break: keep-all; }
  a { display: inline-flex; min-height: 46px; align-items: center; justify-content: center; padding: 11px 18px; border-radius: 8px; background: #1f5f99; color: #fff; font-size: 15px; font-weight: 700; text-decoration: none; }
  a:hover { background: #194f80; }
  small { display: block; margin-top: 11px; color: #7b8794; font-size: 11px; line-height: 1.55; }
  @media (max-width: 760px) { .naver-package-cta { margin-top: 30px; padding: 18px 16px; } h2 { font-size: 19px; } p { font-size: 15px; } a { width: 100%; } }
</style>
