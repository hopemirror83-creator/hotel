---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSenseSlot from '../../components/AdSenseSlot.astro';
import InArticleAd from '../../components/InArticleAd.astro';
import { bacninhAreaGuides, bacninhHotels, getBacninhAreaGuideHotels } from '../../data/bacninhAreaGuides';
import type { BacninhAreaGuide } from '../../data/bacninhAreaGuides';

export function getStaticPaths() {
  return bacninhAreaGuides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide }
  }));
}

const { guide } = Astro.props as { guide: BacninhAreaGuide };
const guideHotels = getBacninhAreaGuideHotels(guide, guide.slug === 'bac-ninh-hotel-comparison' ? 40 : 20);
const today = new Date().toISOString().slice(0, 10);
---
<BaseLayout title={`${guide.title} | 후기 기반 박닌 호텔 선택 가이드`} description={guide.metaDescription} canonicalPath={guide.path}><article class="decision-guide"><section class="decision-hero"><span class="eyebrow">{guide.eyebrow}</span><h1>{guide.title}</h1><p>{guide.intro}</p><div class="guide-meta-grid"><div><span>지역</span><strong>베트남 박닌</strong></div><div><span>분석 호텔 수</span><strong>{bacninhHotels.length.toLocaleString('ko-KR')}개</strong></div><div><span>페이지 포함</span><strong>{guideHotels.length.toLocaleString('ko-KR')}개</strong></div><div><span>마지막 업데이트</span><strong>{today}</strong></div></div></section><AdSenseSlot placement="top"/><section class="section guide-question-section"><div class="section-title"><span>DECISION QUESTION</span><h2>{guide.intentQuestion}</h2><p>{guide.purpose}</p></div><div class="criteria-list">{guide.criteria.map(c=><span>{c}</span>)}</div></section><InArticleAd/><section class="section"><div class="section-title"><span>TOP LIST</span><h2>추천 후보</h2><p>평점과 후기 수, 위치와 공개 후기 단서를 함께 비교했습니다. 요금과 객실 조건은 예약 날짜에 따라 달라질 수 있습니다.</p></div><div class="guide-card-list">{guideHotels.map((item,index)=><article class="guide-hotel-card"><a class="guide-hotel-image" href={`/hotel/${item.hotel.slug}/`}>{item.hotel.imageUrl?<img src={item.hotel.imageUrl} alt={`${item.hotel.hotelName} 대표 이미지`} loading="lazy"/>:<span>IMAGE</span>}</a><div class="guide-hotel-body"><div class="guide-rank-line"><span>#{index+1}</span><b>{item.hotel.reviewCount?.toLocaleString('ko-KR')??'후기 확인'}건</b></div><h3>{item.hotel.hotelName}</h3><p class="guide-address">{item.hotel.address}</p><div class="guide-metrics"><span>평점 {item.hotel.reviewScore??'확인 필요'}</span><span>{item.tableCells[3]}</span></div><ul class="guide-reasons">{item.reasons.map(r=><li>{r}</li>)}</ul><p class="guide-caution"><strong>주의할 점</strong>{item.caution}</p><div class="guide-tags">{item.tags.map(t=><span>{t}</span>)}</div><a class="text-link" href={`/hotel/${item.hotel.slug}/`}>개별 후기 페이지 보기</a></div></article>)}</div></section><section class="section"><div class="section-title"><span>COMPARISON</span><h2>예약 전 비교표</h2><p>객실, 조식, 산업단지·교통과 실제 소요 시간은 예약 전 다시 확인하세요.</p></div><div class="guide-table-wrap"><table class="guide-table"><thead><tr><th>호텔명</th><th>권역</th><th>평점</th><th>후기 수</th><th>가격대</th><th>추천 대상</th></tr></thead><tbody>{guideHotels.map(item=><tr><th><a href={`/hotel/${item.hotel.slug}/`}>{item.hotel.hotelName}</a></th>{item.tableCells.map(c=><td>{c}</td>)}</tr>)}</tbody></table></div></section><section class="section related-guide-section"><div class="section-title"><span>RELATED GUIDE</span><h2>다른 박닌 호텔 선택 기준</h2></div><div class="related-guide-grid">{bacninhAreaGuides.filter(e=>e.slug!==guide.slug).map(e=><a href={e.path}><span>{e.eyebrow}</span><strong>{e.title}</strong></a>)}</div></section><AdSenseSlot placement="bottom"/></article></BaseLayout>
