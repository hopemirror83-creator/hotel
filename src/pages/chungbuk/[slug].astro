---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSenseSlot from '../../components/AdSenseSlot.astro';
import InArticleAd from '../../components/InArticleAd.astro';
import {
  chungbukAreaGuides,
  chungbukHotels,
  getChungbukAreaGuideHotels
} from '../../data/chungbukAreaGuides';
import type { ChungbukAreaGuide, ChungbukAreaGuideHotel } from '../../data/chungbukAreaGuides';

export function getStaticPaths() {
  return chungbukAreaGuides.map((guide) => ({
    params: { slug: guide.slug },
    props: { guide }
  }));
}

const { guide } = Astro.props as { guide: ChungbukAreaGuide };
const guideHotels: ChungbukAreaGuideHotel[] = getChungbukAreaGuideHotels(
  guide,
  guide.slug === 'chungbuk-hotel-comparison' ? 40 : 20
);
const totalHotelCount = chungbukHotels.length;
const today = new Date().toISOString().slice(0, 10);
const hasEnoughHotels = guideHotels.length >= 8;
const canonicalPath = `/chungbuk/${guide.slug}/`;

function reviewText(item: ChungbukAreaGuideHotel) {
  if (!item.hotel.reviewCount || item.hotel.reviewCount < 20) return '후기 데이터 부족';
  return `${item.hotel.reviewCount.toLocaleString('ko-KR')}건 분석`;
}
---

<BaseLayout title={`${guide.title} | 후기 기반 충북 호텔 선택 가이드`} description={guide.metaDescription} canonicalPath={canonicalPath}>
  <article class="decision-guide">
    <section class="decision-hero">
      <span class="eyebrow">{guide.eyebrow}</span>
      <h1>{guide.title}</h1>
      <p>{guide.intro}</p>
      <div class="guide-meta-grid">
        <div>
          <span>지역</span>
          <strong>충북</strong>
        </div>
        <div>
          <span>분석 호텔 수</span>
          <strong>{totalHotelCount.toLocaleString('ko-KR')}개</strong>
        </div>
        <div>
          <span>페이지 포함</span>
          <strong>{guideHotels.length.toLocaleString('ko-KR')}개</strong>
        </div>
        <div>
          <span>마지막 업데이트</span>
          <strong>{today}</strong>
        </div>
      </div>
    </section>

    <AdSenseSlot placement="top" />

    <section class="section guide-question-section">
      <div class="section-title">
        <span>DECISION QUESTION</span>
        <h2>{guide.intentQuestion}</h2>
        <p>{guide.purpose}</p>
      </div>
      <div class="criteria-list">
        {guide.criteria.map((criterion) => <span>{criterion}</span>)}
      </div>
      {!hasEnoughHotels && (
        <p class="data-warning">현재 이 조건에 맞는 호텔이 8개 미만입니다. 억지로 채우지 않고 후기 데이터 부족으로 표시합니다.</p>
      )}
    </section>

    <InArticleAd />

    <section class="section">
      <div class="section-title">
        <span>TOP LIST</span>
        <h2>추천 후보</h2>
        <p>후기 수, 평점, 위치 신호, 가격 정보를 함께 보고 정리했습니다. 충북 숙소는 실제 방문지와 차량 이동 시간을 먼저 맞춘 뒤 비교하는 편이 좋습니다.</p>
      </div>
      <div class="guide-card-list">
        {guideHotels.map((item, index) => (
          <article class="guide-hotel-card">
            <a class="guide-hotel-image" href={`/hotel/${item.hotel.slug}/`}>
              {item.hotel.imageUrl ? (
                <img src={item.hotel.imageUrl} alt={`${item.hotel.hotelName} 대표 이미지`} loading="lazy" />
              ) : (
                <span>IMAGE</span>
              )}
            </a>
            <div class="guide-hotel-body">
              <div class="guide-rank-line">
                <span>#{index + 1}</span>
                <b>{reviewText(item)}</b>
              </div>
              <h3>{item.hotel.hotelName}</h3>
              <p class="guide-address">{item.hotel.address}</p>
              <div class="guide-metrics">
                <span>평점 {item.hotel.reviewScore ?? '확인 필요'}</span>
                <span>{item.tableCells[3]}</span>
              </div>
              <ul class="guide-reasons">
                {item.reasons.map((reason) => <li>{reason}</li>)}
              </ul>
              <p class="guide-caution"><strong>주의할 점 </strong>{item.caution}</p>
              <div class="guide-tags">
                {item.tags.map((tag) => <span>{tag}</span>)}
              </div>
              <a class="text-link" href={`/hotel/${item.hotel.slug}/`}>개별 후기 페이지 보기</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-title">
        <span>COMPARISON</span>
        <h2>예약 전 비교표</h2>
        <p>같은 충북 숙소라도 청주·오송, 충주, 제천·청풍, 단양처럼 목적지에 따라 선택 기준이 달라집니다.</p>
      </div>
      <div class="comparison-table-wrap">
        <table>
          <thead>
            <tr>
              <th>호텔명</th>
              {guide.tableColumns.map((column) => <th>{column}</th>)}
            </tr>
          </thead>
          <tbody>
            {guideHotels.map((item) => (
              <tr>
                <td><a href={`/hotel/${item.hotel.slug}/`}>{item.hotel.hotelName}</a></td>
                {item.tableCells.map((cell) => <td>{cell}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section related-guide-section">
      <div class="section-title">
        <span>CHUNGBUK GUIDE</span>
        <h2>함께 보면 좋은 충북 호텔 가이드</h2>
        <p>방문 목적지가 다르면 같은 숙소도 장단점이 다르게 보입니다.</p>
      </div>
      <div class="related-guide-grid">
        {chungbukAreaGuides
          .filter((item) => item.slug !== guide.slug)
          .slice(0, 6)
          .map((item) => (
            <a href={item.path}>
              <span>{item.eyebrow}</span>
              <strong>{item.title}</strong>
            </a>
          ))}
      </div>
    </section>
    <AdSenseSlot placement="bottom" />
  </article>
</BaseLayout>
