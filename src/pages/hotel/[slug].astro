function normalizeSearchText(value: string) {
  return value.toLowerCase().replace(/\s+/g, ' ');
}

function buildReviewSignals(hotel: Hotel, analysis: HotelAnalysis) {
  const text = [
    analysis.summary,
    ...analysis.pros,
    ...analysis.cons,
    ...analysis.recommendedFor,
    ...analysis.notRecommendedFor,
    ...analysis.checkPoints
  ].join(' ');

  const baseSignals = [
    { label: '위치', score: text.includes('공항') || text.includes('위치') || text.includes('역') ? 5 : 4 },
    { label: '청결', score: text.includes('청결') || text.includes('깨끗') || text.includes('쾌적') ? 5 : 4 },
    { label: '객실', score: text.includes('넓') || text.includes('객실') || text.includes('룸') ? 4 : 3 },
    { label: '조식', score: text.includes('조식') || text.includes('레스토랑') ? 4 : 3 },
    { label: '커플추천', score: analysis.recommendedFor.some((item: string) => item.includes('커플')) ? 5 : 4 },
    { label: '가족', score: analysis.recommendedFor.some((item: string) => item.includes('가족') || item.includes('아이')) ? 5 : 3 },
    { label: '조용함', score: text.includes('조용') || text.includes('휴식') ? 4 : 3 },
    { label: '공항접근', score: hotel.region.includes('영종') || text.includes('공항') ? 5 : 4 }
  ];

  return baseSignals
    .sort((a, b) => b.score - a.score)
    .slice(0, 4)
    .map((item) => ({ ...item, stars: toStars(item.score) }));
}

function buildReliability(hotel: Hotel) {
  const count = hotel.reviewCount ?? hotel.searchResultCount ?? 0;
  const score = count >= 3000 ? 5 : count >= 1000 ? 4 : count >= 300 ? 3 : 2;
  return {
    count,
    stars: toStars(score),
    label: score >= 5 ? '신뢰도 높음' : score >= 4 ? '신뢰도 양호' : '참고용'
  };
}

function buildChoiceReviewNotes(hotel: Hotel, analysis: HotelAnalysis) {
  const baseScore = Math.max(3, Math.min(5, Math.round((hotel.reviewScore ?? 8) / 2)));
  const items = [
    analysis.pros[0],
    analysis.pros[1] || analysis.recommendedFor[0],
    analysis.pros[2] || analysis.checkPoints[0]
  ].filter(Boolean);

  return items.slice(0, 3).map((item, index) => ({
    stars: toStars(Math.max(3, baseScore - (index === 1 ? 1 : 0))),
    text: toReviewStyleSentence(item)
  }));
}

function toReviewStyleSentence(value: string) {
  const text = value.replace(/[.。]+$/g, '').trim();
  if (!text) return '예약 전에 확인할 만한 장점으로 자주 언급됩니다.';
  return `${text} 점이 선택 이유로 자주 언급됩니다.`;
}

function toStars(score: number) {
  return `${'★'.repeat(score)}${'☆'.repeat(5 - score)}`;
}

function buildVisibleBlogParagraphs(sectionHeading: string, paragraphs: string[]) {
  const seen = new Set<string>();

  return paragraphs
    .map((paragraph) => rewriteStaleRegionalComparison(sectionHeading, paragraph))
    .filter((paragraph) => {
      if (seen.has(paragraph)) return false;
      seen.add(paragraph);
      return true;
    });
}

function rewriteStaleRegionalComparison(sectionHeading: string, paragraph: string) {
  if (displayRegion === '인천') return paragraph;
  if (sectionHeading !== '경쟁 제품과 비교') return paragraph;
  if (!/영종도|공항권|인천공항|인천 공항|공항 근처|공항 환승|공항 접근성/.test(paragraph)) return paragraph;

  const location = pickSearchLocation(hotel, analysis);

  return `${hotel.hotelName}은 ${location} 일정에 맞춰 비교하는 편이 자연스럽습니다. 다른 지역의 숙소와 단순 비교하기보다, 같은 지역의 숙소와 위치, 주차, 객실 컨디션, 가격을 함께 보는 것이 좋습니다.`;
}
const priceText = hotel.dailyRate ? `${hotel.dailyRate.toLocaleString('ko-KR')}원~` : '수집 대기';
const formattedReviewCount = hotel.reviewCount?.toLocaleString('ko-KR');
const bookingNameObjectParticle = hasKoreanBatchim(hotel.hotelName) ? '을' : '를';
const topBookingHook = hotel.landingUrl
  ? formattedReviewCount
    ? `${hotel.hotelName}의 아고다 후기 ${formattedReviewCount}건과 최신 객실 요금을 확인하세요.`
    : '현재 예약 가능 여부와 최신 요금을 확인하세요.'
  : '아고다 후기와 객실 조건 연결을 준비하고 있습니다.';
const bottomBookingHook = hotel.landingUrl
  ? formattedReviewCount
    ? `${hotel.hotelName}${bookingNameObjectParticle} 예약하기 전에 아고다 후기 ${formattedReviewCount}건을 더 확인해보세요.`
    : '아고다 후기와 객실 조건을 더 확인해보세요.'
  : '아고다 후기와 예약 조건 연결을 준비하고 있습니다.';

function hasKoreanBatchim(value = '') {
  const lastCharacter = [...value.trim()].at(-1) ?? '';
  const codePoint = lastCharacter.charCodeAt(0);
  return codePoint >= 0xac00 && codePoint <= 0xd7a3 && (codePoint - 0xac00) % 28 !== 0;
}
