function normalizeRegionLabel(value = '') {
  return extractRegion(value) || value.replace(/\s+/g, ' ').trim();
}

function pickLocalKeyword(text: string, region: string) {
  if (region === '지바·나리타') {
    const rules = [
      { keyword: '나리타공항', patterns: ['나리타', 'narita', 'tokko', '공항', 'airport'] },
      { keyword: '디즈니·우라야스', patterns: ['디즈니', 'disney', '마이하마', 'maihama', '우라야스', 'urayasu'] },
      { keyword: '마쿠하리', patterns: ['마쿠하리', 'makuhari', 'hibino', 'mihama'] },
      { keyword: '보소반도', patterns: ['가모가와', 'kamogawa', '다테야마', 'tateyama', '기사라즈', 'kisarazu', '온주쿠', 'onjuku'] },
      { keyword: '지바역', patterns: ['지바역', '치바역', 'chiba station', 'chiba ekimae', 'chuo-ku'] }
    ];
    return rules.find((rule) => rule.patterns.some((pattern) => text.includes(pattern)))?.keyword || '지바';
  }

  if (region === '고베') {
    const rules = [
      { keyword: '아리마온천', patterns: ['아리마', 'arima', '온천', 'onsen'] },
      { keyword: '롯코', patterns: ['롯코', 'rokko', '세이신', 'seishin'] },
      { keyword: '하버랜드', patterns: ['하버랜드', 'harborland', '메리켄', 'meriken', '고베항', 'kobe port'] },
      { keyword: '고베역', patterns: ['고베역', 'kobe station', '히가시카와사키', 'higashikawasaki'] },
      { keyword: '산노미야', patterns: ['산노미야', 'sannomiya', '이소가미', 'isogami'] }
    ];
    return rules.find((rule) => rule.patterns.some((pattern) => text.includes(pattern)))?.keyword || '고베';
  }

  if (region === '히로시마') {
    const rules = [
      { keyword: '미야지마', patterns: ['미야지마', 'miyajima', '이쓰쿠시마', 'itsukushima', '하츠카이치', 'hatsukaichi', '미야하마', 'miyahama'] },
