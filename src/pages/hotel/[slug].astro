<BaseLayout title={longtailSeoTitle} description={metaDescription} canonicalPath={`/hotel/${hotel.slug}/`} alternates={languageAlternates}>
  <article class="hotel-detail">
    <section class="detail-hero">
      <HotelImage
        hotel={hotel}
        alt={`${hotel.hotelName} 대표 이미지`}
        loading="eager"
        pendingClass="detail-image-pending"
      />
      <div class="detail-hero-copy">
        {localizedVersions && (
          <div class="language-switch" aria-label="언어별 페이지">
            <a class="active" href={`/hotel/${hotel.slug}/`}>한국어</a>
            {localizedVersions.en && <a href={`/en/hotel/${hotel.slug}/`}>English</a>}
            {localizedVersions.ja && <a href={`/ja/hotel/${hotel.slug}/`}>日本語</a>}
          </div>
        )}
        <span class="eyebrow">{displayRegion}</span>
        <h1>{longtailHeading}</h1>
        <p>{hotel.address}</p>
        <div class="booking-strip">
          <div>
            <span>아고다 평점</span>
            <strong>{hotel.reviewScore ?? '대기'}</strong>
          </div>
          <div>
            <span>후기 개수</span>
            <strong>{hotel.reviewCount ? hotel.reviewCount.toLocaleString('ko-KR') : '대기'}</strong>
          </div>
          <div>
            <span>예상 가격</span>
            <strong>{averagePriceText || priceText}</strong>
          </div>
        </div>
        <div class="booking-hook">
          <strong>{topBookingHook}</strong>
          <span>객실별 할인 적용 여부는 예약 화면에서 확인할 수 있습니다.</span>
        </div>
        {hotel.landingUrl ? (
          <a class="primary-button full" href={hotel.landingUrl} rel="nofollow sponsored">객실·예약 가능 여부 확인</a>
        ) : (
          <button class="primary-button full" disabled>아고다 예약 버튼 연결 대기</button>
        )}
      </div>
    </section>

    {showNaverTravelPackage && <NaverTravelDisclosure />}
    <AdSenseSlot placement="top" />

    <section class="section summary-section">
      <div class="section-title">
        <span>REVIEW SUMMARY</span>
        <h2>후기 요약</h2>
      </div>
      <p class="summary-text">{analysis.summary}</p>
      <div class="meta-line">
        <span>마지막 갱신: {hotel.lastUpdated ?? '수집 전'}</span>
        <span>분석 검색 결과: {hotel.searchResultCount ?? 0}개</span>
      </div>
    </section>

    <section class="analysis-grid">
      <div class="analysis-box positive">
        <h2>많이 언급된 장점</h2>
        <ul>{analysis.pros.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div class="analysis-box caution">
        <h2>반복적으로 언급된 단점</h2>
        <ul>{analysis.cons.map((item) => <li>{item}</li>)}</ul>
      </div>
      <div class="analysis-box">
        <h2>추천 여행자 유형</h2>
        <ul>{recommendedFor.map((item) => <li>{item}</li>)}</ul>
