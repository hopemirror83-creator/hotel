          <span>아고다 평점</span>
          <strong>{hotel.reviewScore ?? '대기'}</strong>
        </div>
        <div>
          <span>후기 개수</span>
          <strong>{hotel.reviewCount ? hotel.reviewCount.toLocaleString('ko-KR') : '대기'}</strong>
        </div>
        <div>
          <span>예상 가격</span>
          <strong>{averagePriceText || priceText}</strong>
        </div>
      </div>
      <div class="booking-hook booking-hook-bottom">
        <strong>{bottomBookingHook}</strong>
        <span>조식 포함·무료 취소 조건은 객실별로 다를 수 있으니 함께 확인하세요.</span>
      </div>
      {hotel.landingUrl ? (
        <a class="primary-button full" href={hotel.landingUrl} rel="nofollow sponsored">아고다에서 예약 조건 확인</a>
      ) : (
        <button class="primary-button full" disabled>아고다 예약 버튼 연결 대기</button>
      )}
    </section>

    <AdSenseSlot placement="bottom" />
  </article>
</BaseLayout>
