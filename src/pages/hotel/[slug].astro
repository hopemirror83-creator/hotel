  if (hotel.slug.startsWith('gyeongnam-')) return getGyeongnamSearchIntent(hotel);

  if (/^gyeongbuk-|경북|경상북도|Gyeongbuk|Gyeongsangbuk/i.test([hotel.slug, hotel.region, hotel.address].join(' '))) {
    return getGyeongbukSearchIntent(hotel);
  }
  if (/^jeju-|제주|Jeju/i.test([hotel.slug, hotel.region, hotel.address].join(' '))) {
    return getJejuSearchIntent(hotel);
  }
  if (/^busan-|부산|Busan/i.test([hotel.slug, hotel.region, hotel.address].join(' '))) {
    return getBusanSearchIntent(hotel);
  }
  if (/^seoul-|서울|Seoul/i.test([hotel.slug, hotel.region, hotel.address].join(' '))) {
    return getSeoulSearchIntent(hotel);
  }
  if (/^incheon-|인천|Incheon/i.test([hotel.slug, hotel.region, hotel.address].join(' '))) {
    return getIncheonSearchIntent(hotel);
  }
  if (/^gangwon-|강원|Gangwon/i.test([hotel.slug, hotel.region, hotel.address].join(' '))) {
    return getGangwonSearchIntent(hotel);
  }
  if (/^gyeonggi-|경기|Gyeonggi/i.test([hotel.slug, hotel.region, hotel.address].join(' '))) {
    return getGyeonggiSearchIntent(hotel);
  }
  if (/^jeonnam-|전남|전라남도|Jeonnam|Jeolla/i.test([hotel.slug, hotel.region, hotel.address].join(' '))) {
    return getJeonnamSearchIntent(hotel);
  }
  if (/^jeonbuk-|전북|전라북도|Jeonbuk/i.test([hotel.slug, hotel.region, hotel.address].join(' '))) {
    return getJeonbukSearchIntent(hotel);
  }
  if (/^chungbuk-|충북|Chungbuk/i.test([hotel.slug, hotel.region, hotel.address].join(' '))) {
    return getChungbukSearchIntent(hotel);
  }
  if (/^chungnam-|충남|Chungnam/i.test([hotel.slug, hotel.region, hotel.address].join(' '))) {
    return getChungnamSearchIntent(hotel);
  }
  if (/^daegu-|대구|Daegu/i.test([hotel.slug, hotel.region, hotel.address].join(' '))) {
    return getDaeguSearchIntent(hotel);
  }
  if (/^daejeon-|대전|Daejeon/i.test([hotel.slug, hotel.region, hotel.address].join(' '))) {
    return getDaejeonSearchIntent(hotel);
  }
  if (/^gwangju-|광주|Gwangju/i.test([hotel.slug, hotel.region, hotel.address].join(' '))) {
    return getGwangjuSearchIntent(hotel);
  }
  if (/^ulsan-|울산|Ulsan/i.test([hotel.slug, hotel.region, hotel.address].join(' '))) {
    return getUlsanSearchIntent(hotel);
  }
  if (/^gyeongnam-|경남|경상남도|Gyeongnam/i.test([hotel.slug, hotel.region, hotel.address].join(' '))) {
    return getGyeongnamSearchIntent(hotel);
  }
  return (
    getBusanSearchIntent(hotel) ??
    getJejuSearchIntent(hotel) ??
    getGyeonggiSearchIntent(hotel) ??
    getSeoulSearchIntent(hotel) ??
    getGangwonSearchIntent(hotel) ??
    getGwangjuSearchIntent(hotel) ??
    getJeonnamSearchIntent(hotel) ??
    getJeonbukSearchIntent(hotel) ??
    getChungbukSearchIntent(hotel) ??
    getDaeguSearchIntent(hotel) ??
    getDaejeonSearchIntent(hotel) ??
    getChungnamSearchIntent(hotel) ??
    getUlsanSearchIntent(hotel) ??
    getGyeongbukSearchIntent(hotel) ??
    getGyeongnamSearchIntent(hotel) ??
    getIncheonSearchIntent(hotel)
  );
}

function buildLongtailHeading(hotel: Hotel, analysis: HotelAnalysis) {
  const location = pickSearchLocation(hotel, analysis);
  return `${hotel.hotelName} ${location} 후기 모음`;
}

function enrichLongtailHeading(
  hotel: Hotel,
  analysis: HotelAnalysis,
  heading: string,
  searchIntent?: {
    title?: string;
    intentChips?: string[];
    faqs?: Array<{ category?: string; question?: string }>;
  }
) {
  if (hasEnoughLongtailTerms(heading)) return heading;

  const picked = pickLongtailTitleTerms(hotel, analysis, searchIntent)
    .filter((term) => !normalizeSearchText(heading).includes(normalizeSearchText(term)))
    .slice(0, 4);

  if (picked.length === 0) return heading;
  return appendAfterReviewSuffix(heading, picked.join(' '));
}

function buildLongtailSeoTitle(rawSeoTitle: string | undefined, rawTitle: string | undefined, heading: string) {
  if (rawSeoTitle && rawTitle && rawSeoTitle.includes(rawTitle)) {
    return rawSeoTitle.replace(rawTitle, heading);
  }
  return `${heading}｜예약 전 FAQ`;
}

function hasEnoughLongtailTerms(text: string) {
  const normalized = normalizeSearchText(text);
  if (text.includes('·')) return true;
  return getLongtailTitleTerms().filter((term) => normalized.includes(normalizeSearchText(term))).length >= 2;
}

function appendAfterReviewSuffix(heading: string, terms: string) {
  if (/후기\s*모음$/.test(heading)) {
    return heading.replace(/\s*후기\s*모음$/, ` 후기 모음 ${terms}`);
  }
  return `${heading} ${terms}`;
}

function pickLongtailTitleTerms(
  hotel: Hotel,
  analysis: HotelAnalysis,
  searchIntent?: {
    intentChips?: string[];
    faqs?: Array<{ category?: string; question?: string }>;
  }
) {
  const sourceText = normalizeSearchText(
    [
      hotel.hotelName,
      hotel.region,
      hotel.address,
      analysis.summary,
      analysis.seoTitle,
      analysis.metaDescription,
      analysis.pros.join(' '),
      analysis.cons.join(' '),
      analysis.recommendedFor.join(' '),
      analysis.notRecommendedFor.join(' '),
      analysis.checkPoints.join(' '),
      searchIntent?.intentChips?.join(' '),
      searchIntent?.faqs?.map((faq) => `${faq.category ?? ''} ${faq.question ?? ''}`).join(' ')
    ]
      .filter(Boolean)
      .join(' ')
  );

  const directTerms = getLongtailTitleTerms().filter((term) => sourceText.includes(normalizeSearchText(term)));
  return uniqueStrings([...pickDefaultTitleTerms(hotel, analysis), ...directTerms]);
}

function pickDefaultTitleTerms(hotel: Hotel, analysis: HotelAnalysis) {
  const text = normalizeSearchText(
    [hotel.hotelName, hotel.region, hotel.address, analysis.seoTitle, analysis.metaDescription, analysis.summary].join(' ')
  );

  if (/송도|센트럴파크|컨벤시아|업무지구/.test(text)) return ['출장', '체크인', '주차', '조식'];
  if (/운서|인천공항|공항/.test(text)) return ['공항근처', '셔틀', '체크인', '주차'];
  if (/부평|구월|청라|서구|월미|차이나타운/.test(text)) return ['위치', '주차', '체크인', '가성비'];
  if (/강화|석모|동막|펜션/.test(text)) return ['가족', '주차', '객실', '가성비'];
  if (/명동|동대문|종로|인사동|홍대|마포|서울역|용산/.test(text)) return ['위치', '교통', '체크인', '조식'];
  if (/강남|서초|여의도|영등포|잠실|송파|판교|분당|성남|동탄|수원/.test(text)) return ['출장', '주차', '체크인', '조식'];
  if (/해운대|광안리|송도|기장|오시리아|강릉|속초|양양|고성|제주|서귀포|중문|애월|함덕|성산/.test(text)) {
    return ['오션뷰', '주차', '체크인', '가성비'];
  }
  if (/부산역|서면|남포|자갈치|춘천|원주|평창|홍천|김포|일산|고양|용인/.test(text)) {
    return ['위치', '주차', '체크인', '가성비'];
  }
  return ['위치', '체크인', '주차', '조식'];
}

function uniqueStrings(values: string[]) {
  return [...new Set(values.filter(Boolean))];
}

function getLongtailTitleTerms() {
  return [
    '위치',
    '교통',
    '체크인',
    '주차',
    '조식',
    '가성비',
    '가족',
    '가족동반',
    '커플',
    '오션뷰',
    '수영장',
    '호캉스',
    '셔틀',
    '공항근처',
    '짐보관',
    '객실',
    '출장',
    '리조트',
    '펜션',
    '해변',
    '역근처'
  ];
}

function pickSearchLocation(hotel: Hotel, analysis: HotelAnalysis) {
  const region = pickDisplayRegion(hotel, analysis);
  const text = normalizeSearchText([
    hotel.hotelName,
    hotel.address,
    analysis.seoTitle,
    analysis.metaDescription
  ].join(' '));
  const local = pickLocalKeyword(text, region);
  const hotelNameText = normalizeSearchText(hotel.hotelName);

  const parts = [];
  if (local && local !== region && !hotelNameText.includes(normalizeSearchText(local))) {
    parts.push(local);
  }
  if (region && !hotelNameText.includes(normalizeSearchText(region))) {
    parts.push(region);
  }
  return parts.length > 0 ? parts.join(' ') : region;
}

function pickDisplayRegion(hotel: Hotel, analysis: HotelAnalysis) {
  const scores = new Map<string, number>();
  addRegionScore(scores, extractRegion(hotel.region), 2);
  addRegionScore(scores, extractRegion(hotel.address), 2);
  addRegionScore(scores, extractRegion([analysis.seoTitle, analysis.metaDescription, analysis.summary].join(' ')), 4);

  return [...scores.entries()].sort((a, b) => b[1] - a[1])[0]?.[0] || normalizeRegionLabel(hotel.region) || '전국';
}

function addRegionScore(scores: Map<string, number>, region: string, score: number) {
  if (!region) return;
  scores.set(region, (scores.get(region) || 0) + score);
}

