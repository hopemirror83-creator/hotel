---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSenseSlot from '../../components/AdSenseSlot.astro';
import InArticleAd from '../../components/InArticleAd.astro';
import {
  getGuideHotels,
  issueLabel,
  scoreLabel,
  yeongjongGuides,
  yeongjongHotels
} from '../../data/decisionGuides';
import type { DecisionGuide, GuideHotel } from '../../data/decisionGuides';
import {
  getIncheonAreaGuideHotels,
  incheonAreaGuides,
  incheonHotels
} from '../../data/incheonAreaGuides';
import type { IncheonAreaGuide, IncheonAreaGuideHotel } from '../../data/incheonAreaGuides';

type PageGuide =
  | { kind: 'yeongjong'; guide: DecisionGuide }
  | { kind: 'incheon-area'; guide: IncheonAreaGuide };

type PageHotel = GuideHotel | IncheonAreaGuideHotel;

export function getStaticPaths() {
  const yeongjongPaths = yeongjongGuides.map((guide) => ({
    params: { slug: guide.slug },
    props: { pageGuide: { kind: 'yeongjong', guide } }
  }));
  const incheonAreaPaths = incheonAreaGuides.map((guide) => ({
    params: { slug: guide.slug },
    props: { pageGuide: { kind: 'incheon-area', guide } }
  }));
  return [...yeongjongPaths, ...incheonAreaPaths];
}

const { pageGuide } = Astro.props as { pageGuide: PageGuide };
const guide = pageGuide.guide;
let guideHotels: PageHotel[] = [];
if (pageGuide.kind === 'yeongjong') {
  guideHotels = getGuideHotels(pageGuide.guide, pageGuide.guide.slug === 'yeongjongdo-hotel-comparison' ? 18 : 12);
} else {
  guideHotels = getIncheonAreaGuideHotels(pageGuide.guide, pageGuide.guide.slug === 'incheon-hotel-comparison' ? 30 : 20);
}
const totalHotelCount = pageGuide.kind === 'yeongjong' ? yeongjongHotels.length : incheonHotels.length;
const today = new Date().toISOString().slice(0, 10);
const hasEnoughHotels = guideHotels.length >= 8;
const canonicalPath = `/incheon/${guide.slug}/`;

function priceText(item: PageHotel) {
  const price = item.hotel.averageNightlyRate ?? item.hotel.dailyRate;
  return price ? `${price.toLocaleString('ko-KR')}원~` : '가격 확인';
}

function reviewText(item: PageHotel) {
  if (!item.hotel.reviewCount || item.hotel.reviewCount < 300) return '후기 데이터 부족';
  return `${item.hotel.reviewCount.toLocaleString('ko-KR')}건 분석`;
}

function itemReasons(item: PageHotel) {
  return item.reasons.length > 0 ? item.reasons : ['후기와 위치 정보를 기준으로 비교 후보에 포함했습니다.'];
}

function itemTags(item: PageHotel) {
  if (Array.isArray(item.tags)) return item.tags;
  return item.tags.summaryTags;
}

function tableCells(item: PageHotel) {
  if ('tableCells' in item) return item.tableCells;

  const tags = item.tags;
  const hotel = item.hotel;
  if (guide.slug === 'yeongjongdo-family-hotels') {
    return [scoreLabel(tags.familyScore), scoreLabel(tags.roomScore), scoreLabel(tags.parkingScore), issueLabel(tags.noiseIssue), item.target];
  }
  if (guide.slug === 'yeongjongdo-airport-hotels') {
    return [
      scoreLabel(tags.airportScore),
      /셔틀/.test(`${hotel.analysis.summary} ${hotel.analysis.pros.join(' ')}`) ? '셔틀 언급 있음' : '확인 필요',
      /새벽|심야|환승|터미널/.test(`${hotel.analysis.summary} ${hotel.analysis.pros.join(' ')}`) ? '적합' : '확인 필요',
      issueLabel(tags.noiseIssue),
      item.target
    ];
  }
  if (guide.slug === 'yeongjongdo-value-hotels') {
    return [scoreLabel(tags.valueScore), priceText(item), scoreLabel(tags.cleanlinessScore), scoreLabel(tags.roomScore), item.caution];
  }
  if (guide.slug === 'yeongjongdo-ocean-view-hotels') {
    return [scoreLabel(tags.oceanViewScore), locationZone(item), scoreLabel(tags.roomScore), priceText(item), item.caution];
  }
  if (guide.slug === 'yeongjongdo-couple-hotels') {
    return [scoreLabel(tags.coupleScore), scoreLabel(tags.oceanViewScore), scoreLabel(tags.roomScore), issueLabel(tags.noiseIssue), item.target];
  }
  if (guide.slug === 'yeongjongdo-hotel-comparison') {
    return [scoreLabel(tags.familyScore), scoreLabel(tags.coupleScore), scoreLabel(tags.airportScore), scoreLabel(tags.valueScore), item.target];
  }
  return [scoreLabel(tags.airportScore), scoreLabel(tags.valueScore), scoreLabel(tags.roomScore), scoreLabel(tags.cleanlinessScore), item.target];
}

function locationZone(item: PageHotel) {
  const text = `${item.hotel.hotelName} ${item.hotel.address} ${item.hotel.analysis.summary}`;
  if (/구읍뱃터|영종진광장/.test(text)) return '구읍뱃터권';
  if (/을왕리|용유|마시안|선녀바위/.test(text)) return '을왕리·용유권';
  if (/운서|은하수|신도시남로/.test(text)) return '운서역권';
  if (/터미널|공항로|공항문화로/.test(text)) return '공항터미널권';
  return '영종도권';
}
---

<BaseLayout title={`${guide.title}｜후기 기반 선택 가이드`} description={guide.metaDescription} canonicalPath={canonicalPath}>
  <article class="decision-guide">
    <section class="decision-hero">
      <span class="eyebrow">{guide.eyebrow}</span>
      <h1>{guide.title}</h1>
      <p>{guide.intro}</p>
      <div class="guide-meta-grid">
        <div>
          <span>지역</span>
          <strong>{pageGuide.kind === 'yeongjong' ? '인천 영종도' : '인천'}</strong>
        </div>
        <div>
          <span>분석 호텔 수</span>
          <strong>{totalHotelCount.toLocaleString('ko-KR')}개</strong>
        </div>
        <div>
          <span>페이지 포함</span>
          <strong>{guideHotels.length.toLocaleString('ko-KR')}개</strong>
        </div>
        <div>
          <span>마지막 업데이트</span>
          <strong>{today}</strong>
        </div>
      </div>
    </section>

    <AdSenseSlot placement="top" />

    <section class="section guide-question-section">
      <div class="section-title">
        <span>DECISION QUESTION</span>
        <h2>{guide.intentQuestion}</h2>
        <p>{guide.purpose}</p>
      </div>
      <div class="criteria-list">
        {guide.criteria.map((criterion) => <span>{criterion}</span>)}
      </div>
      {!hasEnoughHotels && (
        <p class="data-warning">현재 이 조건에 맞는 호텔이 8개 미만입니다. 억지로 채우지 않고 후기 데이터 부족으로 표시합니다.</p>
      )}
    </section>

    <InArticleAd />

    <section class="section">
      <div class="section-title">
        <span>TOP LIST</span>
        <h2>추천 후보</h2>
        <p>후기 수, 평점, 위치 키워드, 가격 정보를 함께 보고 정렬했습니다. 좋은 점과 확인할 점을 같이 봐야 선택 실수가 줄어듭니다.</p>
      </div>
      <div class="guide-card-list">
        {guideHotels.map((item, index) => (
          <article class="guide-hotel-card">
            <a class="guide-hotel-image" href={`/hotel/${item.hotel.slug}/`}>
              {item.hotel.imageUrl ? (
                <img src={item.hotel.imageUrl} alt={`${item.hotel.hotelName} 대표 이미지`} loading="lazy" />
              ) : (
                <span>IMAGE</span>
              )}
            </a>
            <div class="guide-hotel-body">
              <div class="guide-rank-line">
                <span>#{index + 1}</span>
                <b>{reviewText(item)}</b>
              </div>
              <h3>{item.hotel.hotelName}</h3>
              <p class="guide-address">{item.hotel.address}</p>
              <div class="guide-metrics">
                <span>평점 {item.hotel.reviewScore ?? '확인 필요'}</span>
                <span>{priceText(item)}</span>
              </div>
              <ul class="guide-reasons">
                {itemReasons(item).map((reason) => <li>{reason}</li>)}
              </ul>
              <p class="guide-caution"><strong>주의할 점</strong>{item.caution}</p>
              <div class="guide-tags">
                {itemTags(item).map((tag) => <span>{tag}</span>)}
              </div>
              <a class="text-link" href={`/hotel/${item.hotel.slug}/`}>개별 후기 페이지 보기</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="section">
      <div class="section-title">
        <span>COMPARISON</span>
        <h2>비교표</h2>
        <p>이 표는 {guide.title}의 검색 의도에 맞춰 비교 기준을 다르게 적용했습니다.</p>
      </div>
      <div class="guide-table-wrap">
        <table class="guide-table">
          <thead>
            <tr>
              <th>호텔명</th>
              {guide.tableColumns.map((column) => <th>{column}</th>)}
            </tr>
          </thead>
          <tbody>
            {guideHotels.map((item) => (
              <tr>
                <th><a href={`/hotel/${item.hotel.slug}/`}>{item.hotel.hotelName}</a></th>
                {tableCells(item).map((cell) => <td>{cell}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="section related-guide-section">
      <div class="section-title">
        <span>RELATED GUIDE</span>
        <h2>인천의 다른 호텔 선택 기준</h2>
      </div>
      <div class="related-guide-grid">
        {[...yeongjongGuides, ...incheonAreaGuides].filter((item) => item.slug !== guide.slug).slice(0, 10).map((item) => (
          <a href={item.path}>
            <span>{item.eyebrow}</span>
            <strong>{item.title}</strong>
          </a>
        ))}
      </div>
    </section>
    <AdSenseSlot placement="bottom" />
  </article>
</BaseLayout>
