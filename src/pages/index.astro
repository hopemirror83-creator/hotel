---
import HotelCard from '../components/HotelCard.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { activeHotels as hotels, site } from '../data/hotels';
import { incheonAreaGuides } from '../data/incheonAreaGuides';
import { seoulAreaGuides } from '../data/seoulAreaGuides';
import { busanAreaGuides } from '../data/busanAreaGuides';
import { gyeonggiAreaGuides } from '../data/gyeonggiAreaGuides';
import { jejuAreaGuides } from '../data/jejuAreaGuides';
import { gangwonAreaGuides } from '../data/gangwonAreaGuides';
import { jeonnamAreaGuides } from '../data/jeonnamAreaGuides';
import { jeonbukAreaGuides } from '../data/jeonbukAreaGuides';
import { chungbukAreaGuides } from '../data/chungbukAreaGuides';
import { chungnamAreaGuides } from '../data/chungnamAreaGuides';
import { daeguAreaGuides } from '../data/daeguAreaGuides';
import { daejeonAreaGuides } from '../data/daejeonAreaGuides';
import { ulsanAreaGuides } from '../data/ulsanAreaGuides';
import { gyeongbukAreaGuides } from '../data/gyeongbukAreaGuides';
import { gyeongnamAreaGuides } from '../data/gyeongnamAreaGuides';
import type { Hotel } from '../data/hotels';

const totalHotels = hotels.length;
const japanPrefixes = new Set(['osaka','tokyo','fukuoka','kyoto','sapporo','okinawa','nagoya','hiroshima','kobe','yokohama','chiba','miyagi','hakone','ishikawa','toyama','fukui','niigata','nagano','gifu','shizuoka','yamanashi','gunma','tochigi','ibaraki','saitama','fukushima','yamagata','akita','iwate','aomori','hokkaido','okayama','tottori','shimane','yamaguchi','kagawa','tokushima','ehime','kochi','mie','shiga','nara','wakayama','saga','nagasaki','kumamoto','oita','miyazaki','kagoshima','tsushima']);
const countryOf = (hotel: Hotel) => hotel.slug.startsWith('yenbai-') || hotel.slug.startsWith('sonla-') || hotel.slug.startsWith('hoabinh-') || hotel.slug.startsWith('danang-') || hotel.slug.startsWith('nhatrang-') || hotel.slug.startsWith('phuquoc-') || hotel.slug.startsWith('hochiminh-') || hotel.slug.startsWith('hanoi-') || hotel.slug.startsWith('dalat-') || hotel.slug.startsWith('hoian-') || hotel.slug.startsWith('hue-') || hotel.slug.startsWith('muine-') || hotel.slug.startsWith('vungtau-') || hotel.slug.startsWith('sapa-') || hotel.slug.startsWith('halong-') || hotel.slug.startsWith('ninhbinh-') || hotel.slug.startsWith('haiphong-') || hotel.slug.startsWith('cantho-') || hotel.slug.startsWith('quynhon-') || hotel.slug.startsWith('centralhighlands-') || hotel.slug.startsWith('northernloop-') || hotel.slug.startsWith('quangbinh-') || hotel.slug.startsWith('nghean-') || hotel.slug.startsWith('thanhhoa-') || hotel.slug.startsWith('quangtri-') || hotel.slug.startsWith('quangngai-') || hotel.slug.startsWith('quangnam-') || hotel.slug.startsWith('bacninh-') || hotel.slug.startsWith('haiduong-') || hotel.slug.startsWith('bacgiang-') || hotel.slug.startsWith('vinhphuc-') || hotel.slug.startsWith('phutho-') ? '베트남' : japanPrefixes.has(hotel.slug.split('-')[0]) ? '일본' : '';
const popularity = (hotel: Hotel) => (hotel.reviewCount || 0) * Math.max(hotel.reviewScore || 0, 1);
const isOverseasHotel = (hotel: Hotel) => Boolean(countryOf(hotel)) || hotel.slug.startsWith('dienbien-') || hotel.slug.startsWith('laichau-') || hotel.slug.startsWith('tuyenquang-') || hotel.slug.startsWith('thainguyen-') || hotel.slug.startsWith('langson-') || hotel.slug.startsWith('hungyen-') || hotel.slug.startsWith('namdinh-') || hotel.slug.startsWith('thaibinh-');
const domesticHotels = hotels.filter((hotel) => !isOverseasHotel(hotel));
const overseasHotels = hotels.filter(isOverseasHotel);
const popularDomesticHotels = [...domesticHotels].sort((a, b) => popularity(b) - popularity(a)).slice(0, 20);
const popularOverseasHotels = [...overseasHotels].sort((a, b) => popularity(b) - popularity(a)).slice(0, 20);
const domesticGuideGroups = [
  { name: '서울', guides: seoulAreaGuides }, { name: '경기', guides: gyeonggiAreaGuides },
  { name: '제주', guides: jejuAreaGuides }, { name: '부산', guides: busanAreaGuides },
  { name: '인천', guides: incheonAreaGuides }, { name: '강원', guides: gangwonAreaGuides },
  { name: '전남', guides: jeonnamAreaGuides }, { name: '전북', guides: jeonbukAreaGuides },
  { name: '충북', guides: chungbukAreaGuides }, { name: '충남', guides: chungnamAreaGuides },
  { name: '대구', guides: daeguAreaGuides }, { name: '대전', guides: daejeonAreaGuides },
  { name: '울산', guides: ulsanAreaGuides }, { name: '경북', guides: gyeongbukAreaGuides },
  { name: '경남', guides: gyeongnamAreaGuides }
];
const overseasCountryGroups = ['일본', '베트남'].map((country) => ({
  country,
  hotels: overseasHotels.filter((hotel) => countryOf(hotel) === country || (country === '베트남' && (hotel.slug.startsWith('dienbien-') || hotel.slug.startsWith('laichau-') || hotel.slug.startsWith('tuyenquang-') || hotel.slug.startsWith('thainguyen-') || hotel.slug.startsWith('langson-') || hotel.slug.startsWith('hungyen-') || hotel.slug.startsWith('namdinh-') || hotel.slug.startsWith('thaibinh-')))).sort((a, b) => popularity(b) - popularity(a)).slice(0, 100)
})).filter((group) => group.hotels.length > 0);

function buildHotelGroups(hotels: Hotel[]) {
  const cities = new Map<string, Map<string, Hotel[]>>();

  for (const hotel of hotels) {
    const city = normalizeCity(hotel);
    const district = normalizeDistrict(hotel);
    if (!cities.has(city)) cities.set(city, new Map());
    const districts = cities.get(city)!;
    if (!districts.has(district)) districts.set(district, []);
    districts.get(district)!.push(hotel);
  }

  return Array.from(cities.entries())
    .sort(([a], [b]) => a.localeCompare(b, 'ko-KR'))
    .map(([city, districts]) => ({
      city,
      count: Array.from(districts.values()).reduce((sum, items) => sum + items.length, 0),
      districts: Array.from(districts.entries())
        .sort(([a], [b]) => a.localeCompare(b, 'ko-KR'))
        .map(([district, items]) => ({
          district,
          hotels: items.sort((a, b) => (b.reviewCount || 0) - (a.reviewCount || 0))
        }))
    }));
}

function normalizeCity(hotel: Hotel) {
  const scores = new Map<string, number>();
  addCityScore(scores, extractCity(hotel.region), 2);
  addCityScore(scores, extractCity(hotel.address), 2);
  addCityScore(scores, extractCity([
    hotel.analysis.seoTitle,
    hotel.analysis.metaDescription,
    hotel.analysis.summary
  ].join(' ')), 4);

  return [...scores.entries()].sort((a, b) => b[1] - a[1])[0]?.[0] || hotel.region || '전국';
}

function addCityScore(scores: Map<string, number>, city: string, score: number) {
  if (!city) return;
  scores.set(city, (scores.get(city) || 0) + score);
}

function extractCity(value = '') {
  if (/서울|seoul/i.test(value)) return '서울';
  if (/부산|busan/i.test(value)) return '부산';
  if (/제주|jeju/i.test(value)) return '제주';
  if (/강원|gangwon/i.test(value)) return '강원';
  if (/경기|gyeonggi/i.test(value)) return '경기';
  if (/인천|incheon/i.test(value)) return '인천';
  if (/전북|전라북도|전북특별자치도|jeonbuk/i.test(value)) return '전북';
  if (/대구|daegu/i.test(value)) return '대구';
  if (/대전|daejeon/i.test(value)) return '대전';
  if (/광주|gwangju/i.test(value)) return '광주';
  if (/울산|ulsan/i.test(value)) return '울산';
  if (/세종|sejong/i.test(value)) return '세종';
  if (/충북|충청북도|chungbuk/i.test(value)) return '충북';
  if (/충남|충청남도|chungnam/i.test(value)) return '충남';
  if (/전북|전라북도|jeonbuk/i.test(value)) return '전북';
  if (/전남|전라남도|jeonnam/i.test(value)) return '전남';
  if (/경북|경상북도|gyeongbuk/i.test(value)) return '경북';
  if (/경남|경상남도|gyeongnam/i.test(value)) return '경남';
  return '';
}

function normalizeDistrict(hotel: Hotel) {
  const text = `${hotel.hotelName} ${hotel.address} ${hotel.analysis.seoTitle} ${hotel.analysis.summary}`;
  const lower = text.toLowerCase();

  if (/송도|연수구|컨벤시아|센트럴파크|테크노파크/.test(text)) return '연수구';
  if (/운서|영종|인천공항|공항로|제2터미널|jung-gu|unseo|airport/.test(lower)) return '중구';
  if (/월미|차이나타운|인천역|개항로/.test(text)) return '중구';
  if (/소래포구|소래|남동구|구월/.test(text)) return '남동구';
  if (/부평/.test(text)) return '부평구';
  if (/청라|서구청|검단|서구/.test(text)) return '서구';
  if (/미추홀/.test(text)) return '미추홀구';
  if (/계양/.test(text)) return '계양구';
  if (/명동|을지로|남대문|동대문역사문화공원|동대문디자인플라자|ddp|myeongdong|euljiro|namdaemun/.test(lower)) return '중구';
  if (/강남|역삼|삼성|선릉|코엑스|gangnam|yeoksam|samseong|coex/.test(lower)) return '강남구';
  if (/홍대|합정|상암|마포|공덕|hongdae|hapjeong|sangam|mapo|gongdeok/.test(lower)) return '마포구';
  if (/종로|인사동|광화문|jongno|jongro|insadong|gwanghwamun/.test(lower)) return '종로구';
  if (/동대문|청량리|장안|dongdaemun|cheongnyangni|jangan/.test(lower)) return '동대문구';
  if (/영등포|여의도|당산|yeongdeungpo|yeouido|dangsan/.test(lower)) return '영등포구';
  if (/송파|잠실|석촌|롯데월드|songpa|jamsil|seokchon|lotte world/.test(lower)) return '송파구';
  if (/용산|이태원|서울역|남영|yongsan|itaewon|seoul station|namyeong/.test(lower)) return '용산구';
  if (/강서|김포공항|마곡|화곡|gangseo|gimpo airport|magok|hwagok/.test(lower)) return '강서구';
  if (/구로|신도림|guro|sindorim/.test(lower)) return '구로구';
  if (/서초|교대|양재|seocho|gyodae|yangjae/.test(lower)) return '서초구';
  if (/서대문|신촌|홍제|seodaemun|sinchon|hongje/.test(lower)) return '서대문구';

  const district = text.match(/(?:광역시|특별시|특별자치도|도)\s*([가-힣]+구|[가-힣]+군|[가-힣]+시)/)?.[1]
    || text.match(/\b([A-Za-z]+-gu)\b/i)?.[1];

  if (!district) return '기타';
  return translateEnglishDistrict(district);
}

function translateEnglishDistrict(value: string) {
  const key = value.toLowerCase();
  const map: Record<string, string> = {
    'jung-gu': '중구',
    'yeonsu-gu': '연수구',
    'namdong-gu': '남동구',
    'bupyeong-gu': '부평구',
    'seo-gu': '서구',
    'michuhol-gu': '미추홀구',
    'gyeyang-gu': '계양구',
    'gangnam-gu': '강남구',
    'mapo-gu': '마포구',
    'jongno-gu': '종로구',
    'jongro-gu': '종로구',
    'dongdaemun-gu': '동대문구',
    'yeongdeungpo-gu': '영등포구',
    'songpa-gu': '송파구',
    'yongsan-gu': '용산구',
    'gangseo-gu': '강서구',
    'guro-gu': '구로구',
    'seocho-gu': '서초구',
    'seodaemun-gu': '서대문구',
    'gangdong-gu': '강동구',
    'gwanak-gu': '관악구',
    'gwangjin-gu': '광진구',
    'seongbuk-gu': '성북구',
    'eunpyeong-gu': '은평구',
    'nowon-gu': '노원구',
    'dobong-gu': '도봉구',
    'geumcheon-gu': '금천구',
    'dongjak-gu': '동작구',
    'yangcheon-gu': '양천구',
    'jungnang-gu': '중랑구',
    'seongdong-gu': '성동구'
  };
  return map[key] || value;
}

function cityAnchor(city: string) {
  if (city === '대구') return 'city-daegu';
  if (city === '대전') return 'city-daejeon';
  const map: Record<string, string> = {
    서울: 'seoul',
    부산: 'busan',
    제주: 'jeju',
    인천: 'incheon',
    강원: 'gangwon',
    경기: 'gyeonggi',
    전남: 'jeonnam',
    전북: 'jeonbuk',
    충북: 'chungbuk',
    충남: 'chungnam',
    경북: 'gyeongbuk',
    경남: 'gyeongnam'
  };
  return `city-${map[city] || city.toLowerCase().replace(/\s+/g, '-')}`;
}
---

<BaseLayout
  title={`${site.name} | 인기 호텔 후기`}
  description="호텔로그는 전국 호텔의 위치, 가격, 조식, 체크인, 장점과 주의사항을 요약해 예약 전 빠르게 비교할 수 있도록 돕습니다."
  canonicalPath="/"
>
  <section class="hero">
    <div class="hero-copy">
      <span class="eyebrow">Hotel review intelligence</span>
      <h1>전국 호텔, 예약 전에 나에게 맞는지 먼저 확인하세요.</h1>
      <p>
        호텔로그는 호텔 기본 정보, 위치 정보, 공개 검색 신호를 바탕으로 장점, 아쉬운 점, 추천 여행자 유형, 예약 전 체크포인트를 짧고 명확하게 정리합니다.
      </p>
      <div class="hero-actions">
        <a class="primary-button" href="#hotel-search">전국 호텔 검색하기</a>
        <a class="ghost-button" href="#hotel-regions">지역별 호텔 보기</a>
      </div>
    </div>
    <div class="hero-panel">
      <span>현재 공개 호텔</span>
      <strong>전국 호텔 {totalHotels.toLocaleString('ko-KR')}개</strong>
      <p>인천, 서울, 부산 상위 호텔을 시작으로 제주 등 주요 지역을 순차적으로 확장합니다.</p>
    </div>
  </section>

  <section class="trust-band">
    <div>
      <strong>후기 핵심만 빠르게 확인</strong>
      <span>긴 후기를 일일이 읽지 않아도 위치, 청결, 조식, 객실, 체크인 포인트를 한눈에 비교할 수 있습니다.</span>
    </div>
    <div>
      <strong>예약 전 판단에 집중</strong>
      <span>호텔 홍보 문구보다 실제 선택에 필요한 장점, 반복되는 아쉬움, 추천 여행자 유형을 먼저 정리합니다.</span>
    </div>
    <div>
      <strong>공개 정보 기반 요약</strong>
      <span>공개된 호텔 정보와 검색 신호를 바탕으로 요약하며, 원문 후기를 그대로 옮겨 보여주지 않습니다.</span>
    </div>
  </section>

  <section id="hotel-search" class="section search-section">
    <div class="section-title">
      <span>HOTEL SEARCH</span>
      <h2>호텔로그 안에서 검색</h2>
      <p>호텔명, 지역, 주소, 조식, 체크인, 위치 같은 단어로 현재 공개된 호텔 페이지를 찾아볼 수 있습니다.</p>
    </div>
    <label class="hotel-search-box">
      <span>호텔 검색어</span>
      <input id="hotel-search-input" type="search" placeholder="예: 명동, 강남, 홍대, 운서역, 조식, 파라다이스" autocomplete="off" />
    </label>
    <p id="hotel-search-count" class="search-count">{totalHotels.toLocaleString('ko-KR')}개 호텔이 표시됩니다.</p>
    <div id="hotel-search-results" class="hotel-search-results" hidden aria-live="polite"></div>
  </section>

  <section id="hotels" class="section home-hotel-section">
    <div class="section-title">
      <span>POPULAR HOTEL REVIEWS</span>
      <h2>국내 인기 호텔 후기</h2>
      <p>전국에서 후기 수와 평점이 충분한 대표 호텔 20개를 먼저 보여드립니다.</p>
    </div>
    <div class="hotel-grid home-popular-grid">
      {popularDomesticHotels.map((hotel) => <HotelCard hotel={hotel} />)}
    </div>
  </section>

  <section id="hotel-regions" class="section home-directory-section">
    <div class="section-title">
      <span>DOMESTIC GUIDE</span>
      <h2>국내 지역별 호텔 가이드</h2>
      <p>여행할 지역을 누르면 해당 지역의 주요 권역과 비교 페이지가 펼쳐집니다.</p>
    </div>
    <div class="home-directory-list">
      {domesticGuideGroups.map((group) => (
        <details id={cityAnchor(group.name)} class="home-directory-group" data-city-directory>
          <summary><strong>{group.name}</strong><span>{group.guides.length.toLocaleString('ko-KR')}개 가이드</span></summary>
          <div class="home-directory-links">
            {group.guides.map((guide) => <a href={guide.path}><span>{guide.eyebrow}</span><strong>{guide.title}</strong></a>)}
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="section home-hotel-section">
    <div class="section-title">
      <span>OVERSEAS POPULAR HOTELS</span>
      <h2>해외 인기 호텔 후기</h2>
      <p>현재 공개된 해외 숙소 중 후기 단서가 풍부한 대표 호텔 20개입니다.</p>
    </div>
    <div class="hotel-grid home-popular-grid">
      {popularOverseasHotels.map((hotel) => <HotelCard hotel={hotel} />)}
    </div>
  </section>

  <section class="section home-directory-section">
    <div class="section-title">
      <span>COUNTRY INDEX</span>
      <h2>나라별 해외 호텔 찾기</h2>
      <p>국가를 누르면 현재 공개된 인기 호텔을 확인할 수 있습니다.</p>
    </div>
    <div class="home-directory-list">
      {overseasCountryGroups.map((group) => (
        <details class="home-directory-group">
          <summary><strong>{group.country}</strong><span>인기 호텔 {group.hotels.length.toLocaleString('ko-KR')}개</span></summary>
          <div class="home-country-hotels">
            {group.hotels.map((hotel) => (
              <a href={`/hotel/${hotel.slug}/`}><strong>{hotel.hotelName}</strong><span>{hotel.reviewScore ? `평점 ${hotel.reviewScore}` : '평점 확인'}</span></a>
            ))}
          </div>
        </details>
      ))}
    </div>
  </section>

  {/* Legacy regional sections are intentionally excluded from the homepage.
  <section id="hotels" class="section">
    <div class="section-title">
