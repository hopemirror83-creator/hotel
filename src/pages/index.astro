  <script is:inline>
    const searchInput = document.querySelector('#hotel-search-input');
    const searchCount = document.querySelector('#hotel-search-count');
    const searchResults = document.querySelector('#hotel-search-results');
    let searchIndex;
    let searchTimer;

    function normalize(value) {
      return String(value || '').toLowerCase().replace(/\s+/g, ' ').trim();
    }

    async function loadSearchIndex() {
      if (!searchIndex) {
        const response = await fetch('/hotel-search.json');
        if (!response.ok) throw new Error('호텔 검색 데이터를 불러오지 못했습니다.');
        searchIndex = await response.json();
      }
      return searchIndex;
    }

    async function updateHotelSearch() {
      const query = normalize(searchInput?.value);
      if (!query) {
        if (searchResults) {
          searchResults.replaceChildren();
          searchResults.hidden = true;
        }
        if (searchCount) searchCount.textContent = '호텔명, 지역 또는 주소를 입력해 주세요.';
        return;
      }

      if (searchCount) searchCount.textContent = '호텔 페이지를 검색하고 있습니다.';
      let matches = [];
      try {
        const index = await loadSearchIndex();
        matches = index.filter((hotel) => normalize(hotel.search).includes(query));
      } catch {
        if (searchCount) searchCount.textContent = '검색 데이터를 불러오지 못했습니다. 잠시 후 다시 시도해 주세요.';
        return;
      }

      if (searchResults) {
        searchResults.replaceChildren();
        searchResults.hidden = !query;
        matches.slice(0, 50).forEach((hotel) => {
          const result = document.createElement('a');
          result.href = `/hotel/${hotel.slug}/`;
          result.className = 'hotel-search-result';
          const name = document.createElement('strong');
          name.textContent = hotel.name || '호텔 페이지';
          const meta = document.createElement('span');
          meta.textContent = [hotel.region, hotel.score ? `평점 ${hotel.score}` : ''].filter(Boolean).join(' · ');
          result.append(name, meta);
          searchResults.append(result);
        });
        if (matches.length > 50) {
          const notice = document.createElement('p');
          notice.className = 'hotel-search-more';
          notice.textContent = `검색 결과가 많아 상위 50개만 표시합니다. 검색어를 더 구체적으로 입력해 주세요.`;
          searchResults.append(notice);
        }
      }

      if (searchCount) {
        searchCount.textContent = `${matches.length.toLocaleString('ko-KR')}개 호텔 페이지가 검색되었습니다.`;
      }
    }

    searchInput?.addEventListener('input', () => {
      window.clearTimeout(searchTimer);
      searchTimer = window.setTimeout(updateHotelSearch, 180);
    });
    searchInput?.addEventListener('keydown', async (event) => {
      if (event.key !== 'Enter') return;
      event.preventDefault();
      window.clearTimeout(searchTimer);
      await updateHotelSearch();
      const firstResult = searchResults?.querySelector('a');
      if (firstResult && searchResults) {
        searchResults.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        firstResult.focus({ preventScroll: true });
      }
    });

    function openCityDirectoryFromHash() {
      const hash = decodeURIComponent(window.location.hash.slice(1));
      if (!hash.startsWith('city-')) return;
      const directory = document.getElementById(hash);
      if (!(directory instanceof HTMLDetailsElement)) return;
      directory.open = true;
      window.requestAnimationFrame(() => directory.scrollIntoView({ behavior: 'smooth', block: 'start' }));
    }

    window.addEventListener('hashchange', openCityDirectoryFromHash);
    openCityDirectoryFromHash();
    const initialCity = new URLSearchParams(window.location.search).get('city');
    if (initialCity && searchInput) {
      searchInput.value = initialCity;
      updateHotelSearch();
    }
  </script>
